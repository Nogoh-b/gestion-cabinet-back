# =============================================================================
#  KabySoft Backend — Modèle de configuration
# =============================================================================
#  Copiez ce fichier en .env et renseignez les VRAIES valeurs.
#  Ne JAMAIS committer le .env (il est ignoré par .gitignore).
#  En production, utilisez un coffre-fort de secrets (Vault, AWS Secrets
#  Manager, Doppler...) plutôt que ce fichier.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development            # development | production
PORT=3004
APP_URL=http://localhost:3005
API_HOST=http://localhost:3004

# ── Sécurité JWT ─────────────────────────────────────────────────────────────
# SECRET OBLIGATOIRE en production (≥ 24 caractères aléatoires).
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ── Base de données MySQL ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=kabysoft
# Synchronize l'ORM sur le schéma — UNIQUEMENT en développement
SYNCHRONIZE=true

# ── Redis / Bull (queues) ────────────────────────────────────────────────────
BULL_REDIS_HOST=127.0.0.1
BULL_REDIS_PORT=6379
BULL_REDIS_DB=0
BULL_REDIS_PASSWORD=
BULL_QUEUE_PREFIX=kabysoft

# ── SMTP (e-mails transactionnels) ───────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="No Reply" <no-reply@example.com>

# ── CORS (origines autorisées, séparées par virgule) ─────────────────────────
# En production, liste EXPLICITE des front-ends autorisés.
# Ne JAMAIS utiliser '*' avec credentials.
CORS_ORIGINS=http://localhost:3000

# ── Microservice TCP interne ─────────────────────────────────────────────────
MICROSERVICE_HOST=0.0.0.0
MICROSERVICE_PORT=2999

# ── IA (LangChain) ───────────────────────────────────────────────────────────
# Renseigner UNIQUEMENT les providers utilisés.
DEEPSEEK_API_KEY=
GLM_API_KEY=
GEMINI_API_KEY=
AGNES_API_KEY=
XAI_API_KEY=
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_GLM_BASE_URL=https://api.deepseek.com
AI_VERBOSE=false
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0
AI_FAST_MODEL=
AI_QUALITY_MODEL=
AI_STREAM_MODEL=
AI_TIMEOUT_MS=35000
AI_MAX_RETRIES=0

# ── Paiement / API Mendo Coti ────────────────────────────────────────────────
ENDPOINT_MCOTI=
CUSTOMER_KEY_DISBURSEMENT=
CUSTOMER_SECRET_DISBURSEMENT=

# ── Rate limiting (par fenêtre de ttl secondes) ──────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
