# =============================================================================
#  KabySoft Backend — Modèle de configuration
# =============================================================================
#  Copiez ce fichier en .env et renseignez les VRAIES valeurs.
#  Ne JAMAIS committer le .env (il est ignoré par .gitignore).
#  En production, utilisez un coffre-fort de secrets (Vault, AWS Secrets
#  Manager, Doppler...) plutôt que ce fichier.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development            # development | production
PORT=3004
APP_URL=http://localhost:3005
API_HOST=http://localhost:3004

# ── Sécurité JWT ─────────────────────────────────────────────────────────────
# SECRET OBLIGATOIRE en production (≥ 24 caractères aléatoires).
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ── Base de données MySQL ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=kabysoft
# Synchronize l'ORM sur le schéma — UNIQUEMENT en développement
SYNCHRONIZE=true

# ── Redis / Bull (queues) ────────────────────────────────────────────────────
BULL_REDIS_HOST=127.0.0.1
BULL_REDIS_PORT=6379
BULL_REDIS_DB=0
BULL_REDIS_PASSWORD=
BULL_QUEUE_PREFIX=kabysoft

# ── SMTP (e-mails transactionnels) ───────────────────────────────────────────
# SMTP_HOST doit correspondre exactement à un altname (SAN) du certificat TLS
# présenté par le serveur, sinon Node rejette la connexion avec
# ERR_TLS_CERT_ALTNAME_INVALID. Ex. cabisoft-manager.com et NON mail.cabisoft-manager.com
# (le serveur 169.58.160.40:465 ne couvre que DNS:cabisoft-manager.com).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="No Reply" <no-reply@example.com>

# ── CORS (origines autorisées, séparées par virgule) ─────────────────────────
# En production, liste EXPLICITE des front-ends autorisés.
# Ne JAMAIS utiliser '*' avec credentials.
CORS_ORIGINS=http://localhost:3000

# ── Microservice TCP interne ─────────────────────────────────────────────────
MICROSERVICE_HOST=0.0.0.0
MICROSERVICE_PORT=2998

# ── IA (LangChain) — fallback global (surchargé par la config par cabinet) ───
# La config par cabinet (table cabinets.ai_config) prime sur ces variables.
# Ces ENV ne servent que de fallback si aucun ai_config n'est défini.
# Voir /platform/ia pour configurer : DeepSeek, GLM (Z.AI), Meta AI, FreeLLM...
DEEPSEEK_API_KEY=
GLM_API_KEY=
GEMINI_API_KEY=
AGNES_API_KEY=
XAI_API_KEY=
# Clés des fournisseurs intégrés (serveur uniquement, jamais renvoyées au navigateur) :
META_API_KEY=
FREELLM_API_KEY=
GOOGLE_API_KEY=
# GEMINI_API_KEY= accepté en alias de GOOGLE_API_KEY
# GOOGLE_BASE_URL= optionnel, défaut https://generativelanguage.googleapis.com/v1beta/openai/
META_BASE_URL=https://api.meta.ai/v1
FREELLM_BASE_URL=https://freellm.bisoft-solutions.com/v1
AI_CONFIG_ENCRYPTION_KEY=
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_GLM_BASE_URL=https://api.z.ai/api/paas/v4
AI_STREAM_BASE_URL=https://api.deepseek.com
AI_VERBOSE=false
# true = le chat IA affiche les requêtes SQL et les tableaux de résultats bruts (diagnostic)
AI_CHAT_SHOW_SQL=false
# Lecture des images et PDF numérisés du chat : le moteur du cabinet les lit lui-même s'il en est capable
# (DeepSeek via deepseek-flash, sans réflexion ; Gemini via son modèle), écriture manuscrite comprise.
# Sinon (FreeLLM…) : OCR local (tesseract), texte imprimé seulement, rien ne quitte le serveur.
# Pour imposer un autre modèle : AI_VISION_MODEL (+ AI_VISION_PROVIDER, fournisseur du moteur par défaut),
# ou AI_VISION_MODEL + AI_VISION_BASE_URL + AI_VISION_API_KEY (compatible OpenAI).
AI_VISION_MODEL=
AI_VISION_PROVIDER=
AI_VISION_BASE_URL=
AI_VISION_API_KEY=
# Lectures OCR simultanées (pages d'un scan) : 2 par défaut, ~150 Mo de mémoire chacune, libérées après 10 min d'inactivité.
OCR_WORKERS=2
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0
AI_FLASH_MODEL=deepseek-v4-flash
AI_PRECISE_MODEL=deepseek-v4-pro
AI_FAST_MODEL=deepseek-v4-flash
AI_QUALITY_MODEL=deepseek-v4-flash
AI_STREAM_MODEL=deepseek-v4-flash
AI_TIMEOUT_MS=35000
AI_MAX_RETRIES=0

# ── Paiement / API Mendo Coti ────────────────────────────────────────────────
ENDPOINT_MCOTI=
CUSTOMER_KEY_DISBURSEMENT=
CUSTOMER_SECRET_DISBURSEMENT=

# ── Rate limiting (par fenêtre de ttl secondes) ──────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ── Espace plateforme (super admin) ─────────────────────────────────────────
# Secret DISTINCT de JWT_SECRET (obligatoire en production, 24+ caractères).
PLATFORM_JWT_SECRET=
PLATFORM_JWT_EXPIRES_IN=8h
PLATFORM_NAME=KabySoft
# URL publique du front (liens d'invitation, retours de paiement).
APP_FRONTEND_URL=http://localhost:3000
# URL publique de l'API (URLs de webhook à déclarer chez les passerelles).
API_PUBLIC_URL=http://localhost:3004
# Chiffrement des clés des passerelles de paiement (32+ caractères).
PAYMENT_CONFIG_ENCRYPTION_KEY=
# Passerelle de test / simulation / outils DEV (jamais en production ;
# actif par défaut hors production, mettre false pour le couper).
PAYMENT_TEST_ENABLED=true
PLATFORM_CURRENCY=XAF
# Tableau Bull Board (/admin/queues) — inaccessible en production sans ces valeurs.
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=

# ── Variables déjà utilisées par le code ─────────────────────────────────────
BASE_DOMAIN=
BACKUP_DIR=
CLEANUP_UNPAID_CABINETS_DAYS=
