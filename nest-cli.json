{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      "core/shared/emails/templates/**/*",
      { "include": "core/ai-database/help-docs/**/*.md", "outDir": "dist/src" },
      { "include": "modules/cabinet/assets/**/*", "outDir": "dist/src" },
      { "include": "modules/export/viewer/**/*", "outDir": "dist/src" }
    ],
    "watchAssets": false
  }
}
